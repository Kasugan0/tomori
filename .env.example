# Tomori (#141 公共照明故障工单系统) Environment Configuration Example
# Copy to .env for local development (never commit real secrets or .env).

# --- Runtime ---
APP_ENV=development
TZ=Asia/Shanghai

# --- PostgreSQL Container & psycopg v3 Connections ---
# Note: Host port 25432 avoids 5432 (artex-pg) and 15432 (new-new-api-postgres-1).
TOMORI_PG_HOST=127.0.0.1
TOMORI_PG_PORT=25432
TOMORI_PG_USER=tomori
TOMORI_PG_PASSWORD=tomori_dev_password
TOMORI_PG_DB=tomori_dev
TOMORI_PG_TEST_DB=tomori_test

# SQLAlchemy 2.0 + psycopg v3 uses the same postgresql+psycopg:// URL for both
# create_async_engine() (FastAPI runtime) and sync/async Alembic migrations.
DATABASE_URL=postgresql+psycopg://tomori:tomori_dev_password@127.0.0.1:25432/tomori_dev
TEST_DATABASE_URL=postgresql+psycopg://tomori:tomori_dev_password@127.0.0.1:25432/tomori_test
E2E_DATABASE_URL=postgresql+psycopg://tomori:tomori_dev_password@127.0.0.1:25432/tomori_test

# --- Local Service Ports (Bound to 127.0.0.1, conflict-free on host) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18141
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=15173

# Isolated E2E window ports (guarded by ./deploy/stack-guard.sh claim-e2e / release-e2e)
E2E_BACKEND_PORT=18142
E2E_FRONTEND_PORT=15174

CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173

# --- Auth / Security (Local Dev Placeholders Only) ---
JWT_SECRET_KEY=replace-with-local-dev-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Static Inspection & Repair Photo Storage ---
UPLOAD_DIR=./uploads
# 15 MiB aligns with the vision error contract (single file > 15 MiB => 413 IMAGE_SIZE_EXCEEDED);
# 10 MiB rejected compliant 8-14 MiB phone originals.
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# --- Ultralytics YOLO26 Vision Inference ---
# YOLO26 is an official Ultralytics model family (released January 2026); filenames below are
# taken verbatim from the official Detection row, so they need no renaming:
#   https://docs.ultralytics.com/models/yolo26
# Best trained checkpoint pulled back from the remote GPU server:
YOLO_WEIGHTS_PATH=./vision/weights/best.pt
# Pretrained fallback checkpoint name when custom weights are not yet deployed:
# Official checkpoint, same source above; weights downloadable from
#   https://github.com/ultralytics/assets/releases/tag/v8.4.0  (yolo26s.pt = 20,422,725 B)
YOLO_FALLBACK_MODEL=yolo26s.pt
# Use 'cpu' on machines without CUDA; set '0' when GPU is available:
YOLO_DEVICE=cpu
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
# Must equal metrics.json.imgsz of the exported model: export(..., dynamic=False) freezes the
# input size into the ONNX graph, so a mismatch fails at the first inference with a shape error.
# 1024 = Track A training resolution; override to 1280 only for Track B/C checkpoints.
YOLO_IMG_SIZE=1024
YOLO_INFERENCE_ENABLED=true
# auto: fall back to YOLO_FALLBACK_MODEL when custom weights are absent (baseline marked honestly).
# strict_custom: never fall back; health check explicitly reports "not ready" when custom weights
# are missing, so a baseline model can never masquerade as the custom one.
YOLO_INFERENCE_MODE=auto

# --- Remote GPU Training Server (32G-48G VRAM, Operator Reference) ---
# Fill after receiving user SSH/server parameters (see docs/RUNBOOK.md):
GPU_SSH_HOST=replace-with-gpu-server-host
GPU_SSH_PORT=22
GPU_SSH_USER=replace-with-ssh-user
GPU_REMOTE_WORK_DIR=/workspace/tomori-vision
GPU_REMOTE_DATASET_DIR=/data/tomori/datasets
GPU_REMOTE_RUNS_DIR=/workspace/tomori-vision/runs
